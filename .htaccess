# PrestaShop Module Security
# Only scripts, styles, images and PHP entry points can be requested; templates, README, LICENSE
# and config.xml cannot. Each block below is written for Apache 2.4 and for Apache 2.2.

# Apache 2.4
<IfModule mod_authz_core.c>
    Require all denied
    <FilesMatch "\.(php|js|css|png|webp)$">
        Require all granted
    </FilesMatch>
</IfModule>

# Apache 2.2
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
    <FilesMatch "\.(php|js|css|png|webp)$">
        Allow from all
    </FilesMatch>
</IfModule>
